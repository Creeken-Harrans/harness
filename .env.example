# DeepSeek API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek OpenAI-compatible base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Current DeepSeek docs list deepseek-v4-flash and deepseek-v4-pro.
# deepseek-chat / deepseek-reasoner are compatibility names scheduled for deprecation.
DEEPSEEK_MODEL=deepseek-v4-flash

# enabled | disabled
# disabled is simpler for tool loops; enabled works too because this harness preserves raw assistant tool-call messages during a turn.
DEEPSEEK_THINKING=disabled

# high | max, only used when DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high

# Approximate input context cap. The harness estimates tokens by chars / 4.
HARNESS_MAX_CONTEXT_TOKENS=24000

# always = ask before every model-requested shell command
# shell  = ask before shell, but not memory tools
# never  = no approval prompts. Dangerous; not recommended.
HARNESS_APPROVAL_MODE=shell

# Where shell commands run. Default is the project directory.
HARNESS_WORKSPACE=.

# Per shell command timeout.
HARNESS_SHELL_TIMEOUT_MS=20000

# Max stdout+stderr chars returned to the model.
HARNESS_MAX_TOOL_OUTPUT_CHARS=12000
